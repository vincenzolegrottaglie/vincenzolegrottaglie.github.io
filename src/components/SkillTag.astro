---
interface Props {
  name: string;
  url: string;
  newWindow: string;
}
const { name, url, newWindow } = Astro.props;
---
<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-block bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50 hover:text-blue-500 dark:hover:text-blue-300 px-3 py-1.5 rounded-md text-sm font-medium font-mono transition-colors"
  aria-label={`${name} ${newWindow}`}
>{name}</a>
