---
import { t, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];
---
<footer class="text-center py-8 px-6 border-t border-gray-200 dark:border-gray-800 text-gray-500 dark:text-gray-400 text-sm">
  <div class="max-w-5xl mx-auto">
    <p>{c.footer}</p>
  </div>
</footer>
