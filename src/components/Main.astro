---
import { t, skills, projects, contactLinks, type Lang } from '../data/content';
import SkillTag from './SkillTag.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];
---
<main id="main-content">

  <!-- ===== Hero ===== -->
  <section class="bg-gradient-to-br from-gray-50 to-gray-100 dark:from-[#0f1117] dark:to-[#1a1b26] text-center px-6 pt-24 pb-20 md:pt-32 md:pb-24 lg:pt-40 lg:pb-28" aria-labelledby="hero-heading">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-blue-600 dark:text-blue-400 mb-3">{c.hero.eyebrow}</p>
      <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-[3.25rem] font-extrabold leading-tight tracking-tight mb-4">{c.hero.name}</h1>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-xl mx-auto mb-8 leading-relaxed">{c.hero.tagline}</p>
      <a href="#contact" class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 dark:bg-blue-600 dark:hover:bg-blue-700 text-white font-semibold px-7 py-3 rounded-lg transition-colors hover:-translate-y-0.5">
        {c.hero.cta} <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <!-- ===== About ===== -->
  <section id="about" class="px-6 py-20 md:py-24" aria-labelledby="about-heading">
    <div class="max-w-5xl mx-auto">
      <h2 id="about-heading" class="text-2xl md:text-3xl font-bold tracking-tight mb-2">{c.about.heading}</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-10 text-lg">{c.about.subtitle}</p>

      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div class="space-y-4 text-gray-600 dark:text-gray-300 leading-relaxed">
          {c.about.paragraphs.map((p) => <p set:html={p}></p>)}
        </div>

        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => <SkillTag name={skill.name} url={skill.url} newWindow={c.newWindow} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Projects ===== -->
  <section id="projects" class="px-6 py-20 md:py-24" aria-labelledby="projects-heading">
    <div class="max-w-5xl mx-auto">
      <h2 id="projects-heading" class="text-2xl md:text-3xl font-bold tracking-tight mb-2">{c.projectsSection.heading}</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-10 text-lg">{c.projectsSection.subtitle}</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {projects.map((project) => (
          <ProjectCard
            icon={project.icon}
            title={project[lang].title}
            desc={project[lang].desc}
            tags={project.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Contact ===== -->
  <section id="contact" class="px-6 py-20 md:py-24 text-center" aria-labelledby="contact-heading">
    <div class="max-w-5xl mx-auto">
      <h2 id="contact-heading" class="text-2xl md:text-3xl font-bold tracking-tight mb-2">{c.contact.heading}</h2>
      <p class="text-gray-600 dark:text-gray-300 max-w-md mx-auto mb-8 leading-relaxed">{c.contact.subtitle}</p>

      <div class="flex justify-center gap-4 flex-wrap">
        <a href={contactLinks.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 border-2 border-gray-200 dark:border-gray-700 rounded-lg font-medium text-gray-900 dark:text-gray-100 hover:border-blue-600 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 hover:-translate-y-0.5 transition-all" aria-label={c.contact.linkedinAria}>
          <span aria-hidden="true">👥</span> LinkedIn
        </a>
        <a href={contactLinks.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-3 border-2 border-gray-200 dark:border-gray-700 rounded-lg font-medium text-gray-900 dark:text-gray-100 hover:border-blue-600 dark:hover:border-blue-400 hover:text-blue-600 dark:hover:text-blue-400 hover:-translate-y-0.5 transition-all" aria-label={c.contact.githubAria}>
          <span aria-hidden="true">💻</span> GitHub
        </a>
      </div>
    </div>
  </section>

</main>
