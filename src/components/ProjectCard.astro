---
interface Props {
  icon: string;
  title: string;
  desc: string;
  tags: string[];
}
const { icon, title, desc, tags } = Astro.props;
---
<article class="project-card bg-white dark:bg-[#1a1b26] border border-gray-200 dark:border-gray-800 rounded-xl p-7 hover:shadow-lg dark:hover:shadow-black/30">
  <div class="mb-3">
    <span class="text-2xl" aria-hidden="true">{icon}</span>
  </div>
  <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-gray-100">{title}</h3>
  <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-5">{desc}</p>
  <div class="flex flex-wrap gap-3 text-xs font-mono text-gray-500 dark:text-gray-400">
    {tags.map((tag) => <span>{tag}</span>)}
  </div>
</article>
